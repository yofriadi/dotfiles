.dotter/local.toml
.dotter/cache.toml
.dotter/cache

# pi agent: secrets and machine-local state (never commit)
.pi/agent/auth.json
.pi/agent/pi-accounts.json
.pi/agent/models-store.json
.pi/agent/trust.json
.pi/agent/sessions/
.pi/agent/*.log
.pi/agent/**/*.pre-symlink-bak
.pi/agent/*.bak
.pi/agent/npm/
.pi/agent/git/
.pi/agent/ayu/
.pi/agent/fff/
.pi/agent/pi-cache-optimizer-stats.d/
.pi/agent/disabled-skill-overrides/

# fish: machine-local state and Fisher-managed plugins (managed via fish_plugins)
.config/fish/fish_variables
.config/fish/completions/fisher.fish
.config/fish/conf.d/_pure_init.fish
.config/fish/conf.d/pure.fish
.config/fish/functions/_pure*.fish
.config/fish/functions/fish_mode_prompt.fish
.config/fish/functions/fish_prompt.fish
.config/fish/functions/fish_title.fish
.config/fish/functions/fisher.fish

# OrbStack completions (auto-managed on macOS)
.config/fish/completions/docker.fish
.config/fish/completions/kubectl.fish
.config/fish/completions/orbctl.fish
