{
  "imports": [],
  "mcpServers": {
    "exa": {
      "baseUrl": "https://mcp.exa.ai/mcp",
      "lifecycle": "keep-alive",
      "idleTimeoutMs": 300000,
      "allowedTools": ["web_search_exa", "web_fetch_exa"]
    },
    "gh_grep": {
      "baseUrl": "https://mcp.grep.app",
      "lifecycle": "keep-alive",
      "idleTimeoutMs": 300000
    },
    "linkedin": {
      "command": "linkedin-scraper-mcp",
      "lifecycle": "ephemeral"
    },
    "tilth": {
      "command": "tilth",
      "args": ["--mcp"],
      "lifecycle": "keep-alive",
      "idleTimeoutMs": 300000
    }
  }
}
